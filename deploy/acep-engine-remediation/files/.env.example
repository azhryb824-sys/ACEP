# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ACEP_RUNTIME_DATA_DIR=.runtime
ACEP_BOOTSTRAP_DATA_MODE=readonly
ACEP_ENABLE_LEGACY_UI=true
ACEP_SERVICE_MODE=engineering
ACEP_MAX_BODY_BYTES=10485760
ACEP_TRUST_PROXY=false

# Authentication: api-key (default), oidc, or disabled for explicit local development only
ACEP_AUTH_MODE=api-key
ACEP_API_KEY=replace-with-at-least-32-random-characters
ACEP_API_KEY_SUBJECT=local-admin
ACEP_API_KEY_ROLE=admin
ACEP_API_KEY_TENANT=default
# ACEP_API_KEYS_JSON=[{"token":"...","subject":"...","role":"engineer","tenantId":"..."}]
# Optional short-lived HMAC tokens minted by an authenticated frontend gateway.
ACEP_GATEWAY_TOKEN_SECRET=
ACEP_GATEWAY_TOKEN_AUDIENCE=acep-render
# ACEP_ALLOW_INSECURE_DEV=true

# OIDC alternative
# ACEP_OIDC_ISSUER=https://identity.example.com
# ACEP_OIDC_AUDIENCE=acep-api
# ACEP_OIDC_JWKS_HOSTS=identity.example.com

# Browser and abuse controls
ACEP_CORS_ORIGINS=http://localhost:3000
ACEP_RATE_LIMIT_WINDOW_MS=60000
ACEP_RATE_LIMIT_MAX=120
ACEP_METRICS_TOKEN=replace-with-a-separate-random-token

# Engineering-result gate. Keep unverified unless governed evidence has been approved.
ACEP_DATA_PROVENANCE=unverified
ACEP_EXECUTION_MODE=development
ACEP_ALLOW_MOCK_RESULTS=true
ACEP_ENGINEERING_RELEASE_APPROVED=false
# Comma-separated, reviewed route prefixes. Empty is fail-closed.
ACEP_ENGINEERING_ROUTE_ALLOWLIST=
ACEP_BENCHMARK_MIN_ACCURACY=0.80
ACEP_MILLION_MODEL_ENABLED=false
# Keep supplier recommendations fail-closed until identity, speciality, prices, and dates are independently verified.
ACEP_SUPPLIER_DATA_VERIFIED=false

# Vision provider policy. "none" keeps generation disabled.
ACEP_IMAGE_PROVIDER=none
ACEP_VIDEO_PROVIDER=none
ACEP_ALLOW_CLIENT_PROVIDER_SELECTION=false
ACEP_ALLOW_VISION_FALLBACK=false
ACEP_PROVIDER_TIMEOUT_MS=120000
ACEP_PROVIDER_MAX_POLLS=90
ACEP_PROMPT_SEED=acep-development-seed

# OpenAI image provider
OPENAI_API_KEY=
ACEP_OPENAI_IMAGE_MODEL=
ACEP_OPENAI_IMAGE_MEDIA_HOSTS=
ACEP_OPENAI_IMAGE_COST_USD=

# Together image provider
TOGETHER_API_KEY=
ACEP_TOGETHER_IMAGE_MODEL=
ACEP_TOGETHER_IMAGE_MEDIA_HOSTS=
ACEP_TOGETHER_IMAGE_COST_USD=

# Replicate FLUX provider
REPLICATE_API_KEY=
ACEP_REPLICATE_FLUX_VERSION=
ACEP_REPLICATE_MEDIA_HOSTS=replicate.delivery,*.replicate.delivery
ACEP_FLUX_IMAGE_COST_USD=

# Runway video provider
RUNWAY_API_KEY=
RUNWAY_API_URL=https://api.runwayml.com/v1
ACEP_RUNWAY_API_HOSTS=api.runwayml.com
ACEP_RUNWAY_VIDEO_MODEL=
ACEP_RUNWAY_MEDIA_HOSTS=
ACEP_RUNWAY_COST_PER_SECOND_USD=

# Stable Diffusion API. Plain HTTP is accepted only for loopback outside production.
STABLE_DIFFUSION_URL=http://127.0.0.1:7860
STABLE_DIFFUSION_KEY=
ACEP_STABLE_DIFFUSION_HOSTS=localhost,127.0.0.1
ACEP_STABLE_DIFFUSION_MODEL_ID=
ACEP_STABLE_DIFFUSION_IMAGE_COST_USD=

# Reviewed local FLUX runner. All identity fields are mandatory when enabled.
ACEP_ENABLE_LOCAL_FLUX=false
ACEP_FLUX_LOCAL_RUNNER=
ACEP_FLUX_LOCAL_RUNNER_SHA256=
ACEP_FLUX_LOCAL_MODEL_ID=
ACEP_FLUX_LOCAL_MODEL_REVISION=
ACEP_FLUX_PYTHON=python3
ACEP_FLUX_RUNNER_ENV_ALLOWLIST=

# Vision queue and development-only still-frame fallback
ACEP_VISION_QUEUE_CONCURRENCY=2
ACEP_VISION_QUEUE_MAX_PENDING=100
ACEP_VISION_QUEUE_MAX_JOBS=1000
ACEP_ALLOW_FRAME_SEQUENCE_FALLBACK=false

# Legacy visualizer only; never a governed model-release mechanism.
ACEP_LORA_WEIGHTS_PATH=
ACEP_APPROVED_LORA_SHA256=

# Governed LoRA candidate training (in-process training remains disabled in production)
ACEP_LORA_BASE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
ACEP_LORA_BASE_MODEL_REVISION=
ACEP_LORA_TRAINER_SCRIPT=
ACEP_LORA_TRAINER_SCRIPT_SHA256=
ACEP_LORA_TRAINER_ENV_ALLOWLIST=
PYTHON_PATH=python3
# HF_HOME may point to a separately managed cache under the runtime volume.
# HF_HOME=

# Artifact-scoped model deployment gate. Keep closed unless all hashes are approved.
ACEP_MODEL_RELEASE_APPROVED=false
ACEP_MODEL_RELEASE_ID=
ACEP_MODEL_RELEASE_ARTIFACT_SHA256=
ACEP_MODEL_RELEASE_DATASET_SHA256=
ACEP_MODEL_RELEASE_CONFIG_SHA256=
ACEP_MODEL_RELEASE_EVALUATION_SHA256=

# Dataset release governance
ACEP_MIN_CERTIFIED_IMAGES=100

# Explicit development worker; active models are never replaced by queue jobs.
ACEP_UETS_WORKER_ENABLED=false
ACEP_STATE_DURABILITY=ephemeral
ACEP_SOURCE_COMMIT=
