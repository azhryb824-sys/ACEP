{
    "name": "acep",
    "version": "2.0.0",
    "private": true,
    "workspaces": [
        "packages/ace-core",
        "packages/agents/*",
        "packages/ai-services/*",
        "packages/databases",
        "packages/engines/*",
        "packages/knowledge-base",
        "packages/platforms/*",
        "packages/plugins/*",
        "packages/services/*",
        "packages/uets",
        "packages/vision-ai",
        "packages/vision-training"
    ],
    "description": "AI Construction Engineering Platform - Hybrid Engineering Intelligence Platform",
    "scripts": {
        "preinstall": "node scripts/check-node-version.js",
        "build": "npm run build:syntax && npm run build:types",
        "build:syntax": "node scripts/check-js-syntax.js",
        "build:types": "tsc -b && tsc -b packages/ai-services/cad-parser packages/ai-services/bim-parser packages/ai-services/embeddings",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:python": "python3 -m unittest discover -s ai-data-factory/tests -p 'test_*.py'",
        "test:legacy": "node scripts/run-legacy-tests.js",
        "test:e2e": "node scripts/run-e2e-tests.js",
        "test:production-smoke": "node scripts/run-production-smoke.js",
        "test:engines-smoke": "node scripts/smoke-experiment-engines.js",
        "test:engines-matrix": "node scripts/smoke-experiment-matrix.js",
        "test:engineering-acceptance": "node scripts/engineering-acceptance-benchmark.js",
        "test:http-engineering-matrix": "node scripts/http-engineering-matrix.js",
        "train:models:million": "python3 scripts/train-million-project-models.py",
        "validate:data": "node scripts/validate-datasets.js",
        "normalize:uets-data": "node scripts/normalize-uets-datasets.js",
        "verify": "npm run lint && npm run build && npm run validate:data && npm run test:python && npm run test:coverage && npm run test:legacy && npm run test:e2e && npm run test:production-smoke",
        "lint": "eslint server.js packages/security packages/runtime packages/vision-ai/providers packages/vision-ai/shared packages/vision-training scripts tests --ext .js --no-error-on-unmatched-pattern",
        "clean": "rimraf dist *.tsbuildinfo",
        "start": "node server.js",
        "dev": "node server.js",
        "test:engineering-adversarial": "node scripts/engineering-adversarial-audit.js"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "express": "^4.21.0",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^20.19.43",
        "@types/uuid": "^9.0.0",
        "concurrently": "^8.2.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.0",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.1.0",
        "supertest": "7.1.4",
        "ts-node": "^10.9.0",
        "typescript": "5.9.3"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "engines": {
        "node": ">=20 <21"
    },
    "packageManager": "npm@10.8.2",
    "main": "index.js",
    "directories": {
        "doc": "docs",
        "example": "examples"
    },
    "keywords": [],
    "author": "",
    "license": "UNLICENSED"
}
