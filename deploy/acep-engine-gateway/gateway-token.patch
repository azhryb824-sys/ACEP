new file mode 100644
index 0000000..c218a21
--- /dev/null
+++ b/ACEP/packages/ai-engine/engineering-input-guards.js
@@ -0,0 +1,46 @@
+'use strict';
+
+function normalizedText(value) {
+  return String(value || '').normalize('NFKC').toLowerCase()
+    .replace(/[٠-٩]/g, digit => '٠١٢٣٤٥٦٧٨٩'.indexOf(digit))
+    .replace(/[۰-۹]/g, digit => '۰۱۲۳۴۵۶۷۸۹'.indexOf(digit))
+    .replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/٫/g, '.').trim();
+}
+
+function normalizedCapacity(brief) {
+  const value = Number(brief.capacity);
+  const unit = normalizedText(brief.capacityUnit).replace(/\s+/g, '');
+  if (!(value > 0)) return { value: null, unit: null, valid: true, assumed: false };
+  const families = {
+    renewable_energy: { unit: 'MW', units: {mw:1,'ميجاواط':1,'ميغاواط':1,kw:0.001,'كيلوواط':0.001,gw:1000,'جيجاواط':1000} },
+    power_plant: { unit: 'MW', units: {mw:1,'ميجاواط':1,'ميغاواط':1,kw:0.001,'كيلوواط':0.001,gw:1000,'جيجاواط':1000} },
+    power: { unit: 'MVA', units: {mva:1,'ميجافولتامبير':1,'ميغافولتامبير':1,kva:0.001,'كيلوفولتامبير':0.001} },
+    water: { unit: 'm3/day', units: {'m3/day':1,'م3/يوم':1,'مترمكعب/يوم':1,'l/day':0.001,'لتر/يوم':0.001,'m3/h':24,'m3/hour':24,'l/s':86.4} },
+    dam: { unit: 'm3', units: {'m3':1,'م3':1,'مترمكعب':1,'مليونم3':1e6,'millionm3':1e6} },
+  };
+  const family = families[brief.type];
+  if (!family) return { value, unit: brief.capacityUnit || null, valid: true, assumed: !unit };
+  // Backward compatible missing units remain explicit assumptions, never conversions.
+  if (!unit) return { value, unit: family.unit, valid: true, assumed: true };
+  const multiplier = family.units[unit];
+  return { value: multiplier ? value * multiplier : null, unit: family.unit, valid: Boolean(multiplier), assumed: false };
+}
+
+function validCalendarDate(value) {
+  if (!value) return true;
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const date = new Date(value + 'T00:00:00.000Z');
+  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
+}
+
+function sustainabilityPercentage(target) {
+  const text = normalizedText(target).replace(/٪/g, '%');
+  const match = text.match(/(-?\d+(?:[.,]\d+)?)\s*%/);
+  if (!match) return { value: null, status: 'percentage_not_supplied' };
+  const value = Number(match[1].replace(',', '.'));
+  const isIncrease = /زياده|increase/.test(text);
+  if (value < 0 || (!isIncrease && value > 100)) return { value: null, status: 'invalid_percentage' };
+  return { value, status: 'stated_target_not_verified_performance' };
+}
+
+module.exports = { normalizedCapacity, validCalendarDate, sustainabilityPercentage };
