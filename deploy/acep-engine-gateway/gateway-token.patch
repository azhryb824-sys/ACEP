+++ b/ACEP/tests/engineering-acceptance.test.js
@@ -0,0 +1,19 @@
+'use strict';
+
+const { runBenchmark } = require('../scripts/engineering-acceptance-benchmark');
+
+jest.setTimeout(30000);
+
+describe('engineering concept-analysis acceptance benchmark', () => {
+  test('passes at least 98% of explicit engineering acceptance checks', async () => {
+    const report = await runBenchmark();
+    if (!report.accepted) {
+      const failures = report.cases.filter(testCase => testCase.failures.length > 0);
+      console.error(JSON.stringify({ score: report.score, failures }, null, 2));
+    }
+    expect(report.projectCases).toBe(12);
+    expect(report.checks).toBeGreaterThanOrEqual(300);
+    expect(report.score).toBeGreaterThanOrEqual(98);
+    expect(report.accepted).toBe(true);
+  });
+});
