+
+function check(name, condition, evidence) {
+  return { name, passed: Boolean(condition), evidence };
+}
+
+async function analyze(profile, index) {
+  const response = await fetch(`${baseUrl}/api/v1/experiments/analyze`, {
+    method: 'POST',
