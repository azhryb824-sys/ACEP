+    if (raw.length > 2048) return null;
+    payload = JSON.parse(raw.toString('utf8'));
+  } catch {
+    return null;
+  }
+
+  const now = Math.floor(Date.now() / 1000);
+  const validRole = payload.role === 'viewer' || payload.role === 'engineer';
+  const validSubject = typeof payload.sub === 'string' && /^[A-Za-z0-9._:@-]{1,128}$/.test(payload.sub);
+  const validTenant = typeof payload.tenantId === 'string' && /^[A-Za-z0-9._-]{1,128}$/.test(payload.tenantId);
+  const validNonce = typeof payload.nonce === 'string' && /^[A-Za-z0-9_-]{16,128}$/.test(payload.nonce);
+  const validTimes = Number.isInteger(payload.iat) && Number.isInteger(payload.exp)
+    && payload.iat <= now + 30 && payload.exp > now && payload.exp - payload.iat > 0
+    && payload.exp - payload.iat <= 120 && payload.exp <= now + 120;
+  if (payload.v !== 1 || payload.aud !== audience || !validRole || !validSubject || !validTenant || !validNonce || !validTimes) {
+    return null;
+  }
+  return { subject: payload.sub, role: payload.role, tenantId: payload.tenantId, mode: 'gateway-token' };
