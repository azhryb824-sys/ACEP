# ACEP Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000

# Vision AI Providers
# Together AI (recommended - free FLUX.1-schnell)
# Sign up at https://api.together.ai
TOGETHER_API_KEY=

# Replicate (FLUX via API, paid)
