# OpenAI (for DALL-E 3)
OPENAI_API_KEY=

# Stable Diffusion (local server)
STABLE_DIFFUSION_URL=http://localhost:7860

# AI Training
ACEP_ANALYSIS_URL=http://localhost:3000
